# TitanOS: GRUB for boards without 64-bit UEFI (legacy BIOS: i386-pc,
# 32-bit UEFI: i386-efi with EFI/BOOT/BOOTIA32.EFI). 64-bit UEFI starts
# systemd-boot (EFI/BOOT/BOOTX64.EFI) and never reads this file.
#
# The A/B rules are those of systemd-boot, read from the same files in
# /loader/entries that titand writes (see docs/BOOT.md):
#   titanos-<slot>.conf          marked good
#   titanos-<slot>+<left>[-<done>].conf
#                                on trial, <left> tries remain
# A slot on trial with tries left starts first. GRUB cannot rename files on
# FAT, so it counts its tries in /boot/grub/grubenv instead (save_env only
# overwrites that file in place); titand turns the count into the file name
# once the system is up. Without a trial, the good slot that started last
# (titanos_prefer) starts; titand keeps that in step with the sort-key.
#
# Updates never replace this file: everything that changes with a release
# (kernel command line, kernel parameters) lies in the slot itself
# (/titanos/<slot>/bootenv).

set timeout=3
set default=0
set titanos_loader="grub-${grub_cpu}-${grub_platform}"
set titanos_extra=""
# 32-bit UEFI starts the 64-bit kernel in mixed mode. Calls into the
# firmware's runtime services crash some of these firmwares early in boot
# (seen with OVMF ia32, 31.10.2026); TitanOS needs none of them there, as
# GRUB keeps its state in grubenv, not in EFI variables.
if [ "$grub_platform" = "efi" ]; then
    set titanos_extra="efi=noruntime"
fi
# Manual additions for this stick only, e.g. a serial console:
#   set titanos_extra="$titanos_extra console=ttyS0,115200"
if [ -f /boot/grub/custom.cfg ]; then
    source /boot/grub/custom.cfg
fi
export titanos_loader
export titanos_extra

set titanos_trial=""
set titanos_count=0
set titanos_prefer=""
if [ -f /boot/grub/grubenv ]; then
    load_env --file /boot/grub/grubenv titanos_trial titanos_count titanos_prefer
fi
if [ -z "$titanos_count" ]; then
    set titanos_count=0
fi

# titanos_entry <slot>: e_state (none, good, trial), e_name, e_left.
function titanos_entry {
    set e_state=none
    set e_name=""
    set e_left=0
    if [ -f "/loader/entries/titanos-$1+3.conf" ]; then
        set e_state=trial; set e_name="titanos-$1+3.conf"; set e_left=3
    elif [ -f "/loader/entries/titanos-$1+2-1.conf" ]; then
        set e_state=trial; set e_name="titanos-$1+2-1.conf"; set e_left=2
    elif [ -f "/loader/entries/titanos-$1+1-2.conf" ]; then
        set e_state=trial; set e_name="titanos-$1+1-2.conf"; set e_left=1
    elif [ -f "/loader/entries/titanos-$1+2.conf" ]; then
        set e_state=trial; set e_name="titanos-$1+2.conf"; set e_left=2
    elif [ -f "/loader/entries/titanos-$1+1.conf" ]; then
        set e_state=trial; set e_name="titanos-$1+1.conf"; set e_left=1
    elif [ -f "/loader/entries/titanos-$1.conf" ]; then
        set e_state=good
    fi
    # +0 entries (given up on) stay "none".
    if [ ! -f "/titanos/$1/vmlinuz" ]; then
        set e_state=none
    fi
}

# titanos_used <name>: how often GRUB already started this entry on trial.
function titanos_used {
    set t_used=0
    if [ "$titanos_trial" = "$1" ]; then
        set t_used="$titanos_count"
    fi
    if [ "$t_used" = 0 ]; then set t_next=1
    elif [ "$t_used" = 1 ]; then set t_next=2
    elif [ "$t_used" = 2 ]; then set t_next=3
    else set t_next=4
    fi
}

titanos_entry a
set a_state="$e_state"; set a_name="$e_name"; set a_left="$e_left"
titanos_entry b
set b_state="$e_state"; set b_name="$e_name"; set b_left="$e_left"

set pick=""
set pick_trial=no
if [ "$a_state" = trial ]; then
    titanos_used "$a_name"
    if [ "$t_used" -lt "$a_left" ]; then
        set pick=a; set pick_trial=yes; set pick_name="$a_name"; set pick_next="$t_next"
    fi
fi
if [ -z "$pick" ]; then
    if [ "$b_state" = trial ]; then
        titanos_used "$b_name"
        if [ "$t_used" -lt "$b_left" ]; then
            set pick=b; set pick_trial=yes; set pick_name="$b_name"; set pick_next="$t_next"
        fi
    fi
fi
if [ -z "$pick" ]; then
    if [ "$a_state" = good ]; then
        set pick=a
        if [ "$b_state" = good ]; then
            if [ "$titanos_prefer" = b ]; then
                set pick=b
            fi
        fi
    elif [ "$b_state" = good ]; then
        set pick=b
    fi
fi
export pick
export pick_trial
export pick_name
export pick_next

# titanos_boot <slot>: start the system in a slot.
function titanos_boot {
    set titanos_options=""
    if [ -f "/titanos/$1/bootenv" ]; then
        load_env --file "/titanos/$1/bootenv" titanos_options
    fi
    if [ -z "$titanos_options" ]; then
        set titanos_options="@OPTIONS@"
    fi
    echo "TitanOS: System $1"
    linux "/titanos/$1/vmlinuz" $titanos_options titanos.loader=$titanos_loader $titanos_extra
    initrd "/titanos/$1/initrd.img"
    boot
    # Only reached if the system could not be loaded: start over, so that
    # the try counts and the next choice is made afresh.
    echo "TitanOS: System $1 could not be started"
    sleep 5
    reboot
}

if [ -n "$pick" ]; then
    menuentry "TitanOS" --id titanos {
        if [ "$pick_trial" = yes ]; then
            set titanos_trial="$pick_name"
            set titanos_count="$pick_next"
            set titanos_prefer="$pick"
            save_env --file /boot/grub/grubenv titanos_trial titanos_count titanos_prefer
        fi
        titanos_boot "$pick"
    }
else
    # Nothing is marked as startable: only given-up trials are left.
    # Wait for a choice instead of starting one of them on its own.
    set timeout=-1
fi
if [ -f /titanos/a/vmlinuz ]; then
    menuentry "TitanOS: System A (only this time)" --id titanos-a {
        titanos_boot a
    }
fi
if [ -f /titanos/b/vmlinuz ]; then
    menuentry "TitanOS: System B (only this time)" --id titanos-b {
        titanos_boot b
    }
fi
