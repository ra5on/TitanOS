{
	"name": "titanos-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "FSL-1.1-ALv2",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"test": "node --test tests/*.test.mjs && svelte-kit sync && vitest run",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run format:check",
		"format": "prettier --write src tests vite.config.ts vitest.config.ts",
		"format:check": "prettier --check src tests vite.config.ts vitest.config.ts",
		"format:workflows": "npm run format",
		"test:components": "svelte-kit sync && vitest run"
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"gridstack": "^14.0.0",
		"jsdom": "^30.1.3",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@novnc/novnc": "^1.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-search": "^0.16.0",
		"@xterm/xterm": "^6.0.0",
		"qrcode-generator": "^2.0.4",
		"yaml": "^2.9.1"
	}
}
