# Titan External Storage Mounter
# Installed at /etc/systemd/system/titan-external-storage.service

[Unit]
Description=External Storage Mounter
Before=docker.service titan-custom-pre-start.service titan.service

[Service]
Type=oneshot
Restart=no
ExecStart=/opt/titan-external-storage/titan-external-storage
TimeoutStartSec=45min
User=root
Group=root
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=external storage mounter
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
