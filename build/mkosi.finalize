#!/bin/sh
# Runs on the build host once the image tree ($BUILDROOT) is complete.
# Produces the files of one system slot on the stick in $OUTPUTDIR.
set -eu

python3 "$BUILDROOT/usr/share/titanos/build-licenses.py" image "$BUILDROOT"
rm "$BUILDROOT/usr/share/titanos/build-licenses.py"

# These must survive package selection and any future firmware pruning.
for pattern in 'i915/*guc*.bin*' 'i915/*huc*.bin*' 'intel/vpu/*.bin*'; do
    if ! find "$BUILDROOT/usr/lib/firmware" -path "*/$pattern" -print | grep -q .; then
        echo "required Intel firmware missing: $pattern" >&2
        exit 1
    fi
done

set -- "$BUILDROOT"/boot/vmlinuz-*
if [ $# -ne 1 ] || [ ! -e "$1" ]; then
    echo "expected exactly one kernel in /boot, found: $*" >&2
    exit 1
fi
kernel=${1##*/vmlinuz-}

if [ ! -s "$BUILDROOT/boot/initrd.img-$kernel" ]; then
    echo "no initrd for kernel $kernel in /boot" >&2
    exit 1
fi

cp "$BUILDROOT/boot/vmlinuz-$kernel" "$OUTPUTDIR/vmlinuz"
cp "$BUILDROOT/boot/initrd.img-$kernel" "$OUTPUTDIR/initrd.img"
cp "$BUILDROOT/usr/lib/systemd/boot/efi/systemd-bootx64.efi" "$OUTPUTDIR/BOOTX64.EFI"
printf '%s\n' "$kernel" > "$OUTPUTDIR/kernel-version"

# Kernel and initrd are loaded from the stick by the boot loader. Keeping a
# second copy inside the system image would only cost RAM.
rm -f "$BUILDROOT"/boot/vmlinuz-* "$BUILDROOT"/boot/initrd.img-* "$BUILDROOT"/boot/System.map-*

mksquashfs "$BUILDROOT" "$OUTPUTDIR/filesystem.squashfs" \
    -comp zstd -Xcompression-level 19 -b 1M -noappend -no-progress -quiet
