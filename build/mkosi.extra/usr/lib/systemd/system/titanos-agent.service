[Unit]
Description=TitanOS personal Agent worker
After=titand.service systemd-sysusers.service
Wants=titand.service

[Service]
User=_titanos-agent
Group=_titanos-agent
ExecStart=/usr/bin/titand -personal-agent-worker
Restart=always
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
InaccessiblePaths=-/mnt -/config -/efi
UMask=0077
TasksMax=64

[Install]
WantedBy=multi-user.target
