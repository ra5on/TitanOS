[Unit]
Description=TitanOS daemon (web UI and API)
Documentation=https://github.com/ra5on/TitanOS
After=network.target
# On shutdown and restart titand stops before the stick is unmounted: in
# parallel, a write of titand could keep /efi busy and the stick would be
# left with its dirty bit set. efi.mount is nofail, so this pulls nothing in.
After=efi.mount
# An app update that does not start is given up on after three starts and
# the one before it runs again: systemd must not stop trying before that.
StartLimitIntervalSec=2min
StartLimitBurst=10

[Service]
# HTTPS on 443 with a self-signed certificate kept in /config; port 80 redirects.
ExecStart=/usr/bin/titand
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
