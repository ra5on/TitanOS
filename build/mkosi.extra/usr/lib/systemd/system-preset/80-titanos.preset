enable titand.service
enable titanos-firewall-open.service
enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service

# Virtual machines. libvirt starts when the first VM does and stops again
# two minutes after the last one is off. Its guests service shuts the VMs
# down when the NAS does.
enable libvirtd.socket
enable virtlogd.socket
enable libvirt-guests.service

# After an update the new system is on trial. This check marks it good
# once titand is ready; see the unit.
enable titanos-boot-check.service
enable titanos-app-check.service
