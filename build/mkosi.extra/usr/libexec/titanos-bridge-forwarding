#!/bin/sh
set -eu

# Docker can set FORWARD to DROP while br_netfilter sends bridged LAN packets
# through iptables. Permit only L2 forwarding on TitanOS's VM bridge, in Docker's
# supported user chain. Routed traffic and Docker bridges retain their policies.
exec 9>/run/lock/titanos-bridge-forwarding.lock
flock 9
for firewall in iptables ip6tables; do
    "$firewall" -w 5 -S DOCKER-USER >/dev/null 2>&1 || "$firewall" -w 5 -N DOCKER-USER
    if ! "$firewall" -w 5 -C DOCKER-USER -i br0 -o br0 -m physdev --physdev-is-bridged -m comment --comment titanos-vm-bridge -j ACCEPT 2>/dev/null; then
        "$firewall" -w 5 -I DOCKER-USER 1 -i br0 -o br0 -m physdev --physdev-is-bridged -m comment --comment titanos-vm-bridge -j ACCEPT
    fi
    # Also works before Docker's first start and when its IPv6 network is off.
    if ! "$firewall" -w 5 -C FORWARD -j DOCKER-USER 2>/dev/null; then
        "$firewall" -w 5 -I FORWARD 1 -j DOCKER-USER
    fi
done
