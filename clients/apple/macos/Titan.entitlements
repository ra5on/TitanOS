<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Data Protection Keychain uses entitlement-backed access groups. This
	     private group is Titan's own application identifier; it is not shared
	     with another app. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.ra5on.titanos.mac</string>
	</array>
	<!-- The app remains nonsandboxed so it can mount Finder shares. On macOS 15+
	     this team-prefixed container gives its private configuration system-level
	     protection from unrelated processes running as the same user. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.ra5on.titanos.mac</string>
	</array>
</dict>
</plist>
